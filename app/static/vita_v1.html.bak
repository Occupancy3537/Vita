<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F5F4F1">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Vita">
<link rel="manifest" href="/vita-assets/manifest.webmanifest">
<link rel="apple-touch-icon" href="/vita-assets/icon-192.png">
<title>Vita</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme:light;
  --bg:#F5F4F1;
  --ink:#1E2126; --ink2:#4A4E57; --muted:#8A8D94; --faint:#B9BBC0;
  --sage:#9DB89A; --sage-d:#6F8F6C; --sage-t:rgba(157,184,154,.16);
  --lilac:#B8B0D9; --lilac-d:#8378B2; --lilac-t:rgba(184,176,217,.2);
  --apricot:#E8B898; --apricot-d:#B67E58; --apricot-t:rgba(232,184,152,.2);
  --glass:rgba(255,255,255,.6); --line:rgba(255,255,255,.5);
  --shadow:0 20px 60px rgba(90,90,120,.10); --shadow-s:0 8px 24px rgba(90,90,120,.07);
  --ease:cubic-bezier(.22,1,.36,1); --ease-io:cubic-bezier(.65,0,.35,1);
  --font:"Manrope","Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--bg);font-family:var(--font);color:var(--ink);-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent;overflow:hidden;display:grid;place-items:center}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent;text-align:inherit}
a{color:inherit;text-decoration:none}
button:focus-visible,a:focus-visible{outline:2px solid var(--lilac);outline-offset:3px;border-radius:12px}
svg{display:block}
.ic{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}

#app{position:relative;width:100%;height:100%;overflow:hidden;background:var(--bg);isolation:isolate}
@media (min-width:640px) and (min-height:720px){
  body{background:#E9E8E4}
  #app{width:410px;height:min(880px,calc(100% - 48px));border-radius:46px;box-shadow:0 40px 120px rgba(60,60,90,.18),0 0 0 10px #F9F8F6,0 0 0 11px rgba(0,0,0,.05)}
}
#statesPill{position:fixed;left:24px;top:24px;display:none;align-items:center;gap:8px;height:38px;padding:0 16px;border-radius:19px;background:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.8);box-shadow:var(--shadow-s);font-size:13px;color:var(--ink2)}
#statesPill svg{width:15px;height:15px;color:var(--muted)}
@media (min-width:900px) and (min-height:720px){#statesPill{display:flex}}

/* liquid background */
.blobs{position:absolute;inset:0;z-index:0;pointer-events:none}
.blob{position:absolute;left:0;top:0;width:340px;height:340px;transition:transform 2.8s var(--ease-io)}
.blob b{position:absolute;inset:0;border-radius:50%;filter:blur(64px);opacity:.78;transition:background-color 2.2s ease;will-change:transform}
.blob:nth-child(1) b{animation:d1 26s ease-in-out infinite alternate}
.blob:nth-child(2) b{animation:d2 31s ease-in-out infinite alternate}
.blob:nth-child(3) b{animation:d3 23s ease-in-out infinite alternate}
.blob:nth-child(4) b{animation:d4 35s ease-in-out infinite alternate}
@keyframes d1{0%{transform:translate(0,0) scale(1)}50%{transform:translate(40px,30px) scale(1.12)}100%{transform:translate(-30px,50px) scale(.95)}}
@keyframes d2{0%{transform:translate(0,0) scale(1.05)}50%{transform:translate(-50px,-20px) scale(.92)}100%{transform:translate(20px,-40px) scale(1.1)}}
@keyframes d3{0%{transform:translate(0,0) scale(.95)}50%{transform:translate(30px,-40px) scale(1.08)}100%{transform:translate(-40px,20px) scale(1)}}
@keyframes d4{0%{transform:translate(0,0) scale(1)}50%{transform:translate(-30px,40px) scale(1.1)}100%{transform:translate(40px,-10px) scale(.9)}}

/* atoms */
.glass{background:var(--glass);-webkit-backdrop-filter:blur(26px) saturate(150%);backdrop-filter:blur(26px) saturate(150%);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}
.lbl{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:500}
.press{transition:scale .35s var(--ease)}
.press.down{scale:.98}
.chip{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 9px;border-radius:11px;font-size:11px;font-weight:500;letter-spacing:.02em;white-space:nowrap;background:rgba(30,33,38,.05);color:var(--ink2)}
.chip.sage{background:var(--sage-t);color:var(--sage-d)}
.chip.lilac{background:var(--lilac-t);color:var(--lilac-d)}
.chip.apricot{background:var(--apricot-t);color:var(--apricot-d)}
.sec-h{display:flex;justify-content:space-between;align-items:baseline;margin:28px 2px 10px}
.sec-h h2{font-size:21px;font-weight:300;letter-spacing:-.01em}
.sec-h span{font-size:12px;color:var(--muted)}
.linkline{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--sage-d);font-weight:500}
.linkline svg{width:14px;height:14px}

/* stage & tabs */
.stage{position:absolute;inset:0;z-index:1;transition:transform .7s var(--ease)}
.stage.behind{transform:scale(.94) translateY(8px)}
.tab{position:absolute;inset:0;display:flex;flex-direction:column;visibility:hidden;pointer-events:none;transform:translateY(10px);transition:transform .6s var(--ease),visibility 0s .22s}
.tab.on{visibility:visible;pointer-events:auto;transform:none;transition:transform .7s var(--ease),visibility 0s 0s}
.rise{opacity:0;transform:translateY(12px);transition:opacity .18s ease,transform .3s ease,scale .35s var(--ease)}
.on .rise.in,.ov.open .rise{opacity:1;transform:none;transition:opacity .6s var(--ease) calc(var(--i,0)*70ms + 60ms),transform .8s var(--ease) calc(var(--i,0)*70ms + 60ms),scale .35s var(--ease)}

.topbar{flex:none;padding:18px 20px 0;display:flex;justify-content:center}
.switcher{position:relative;display:flex;padding:3px;border-radius:14px;background:rgba(255,255,255,.45);border:1px solid var(--line);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px)}
.switcher button{position:relative;z-index:1;width:92px;height:28px;font-size:12.5px;font-weight:500;color:var(--muted);transition:color .4s ease;text-align:center}
.switcher button.on{color:var(--ink)}
.sw-ind{position:absolute;top:3px;left:3px;width:92px;height:28px;border-radius:11px;background:rgba(255,255,255,.9);box-shadow:0 4px 14px rgba(90,90,120,.10);transition:transform .6s var(--ease)}
.pager{flex:1;min-height:0;overflow:hidden;touch-action:pan-y}
.track{display:flex;width:200%;height:100%;transition:transform .65s var(--ease);will-change:transform}
.screen{height:100%;overflow-y:auto;overflow-x:hidden;padding:0 20px 118px;scrollbar-width:none}
.screen::-webkit-scrollbar{display:none}
.track .screen{width:50%}
.tab>.screen{flex:1;min-height:0;padding-top:22px}

.hdr{display:flex;align-items:center;justify-content:space-between;gap:8px;height:44px;font-size:13px;color:var(--muted)}
.status{display:flex;align-items:center;gap:7px;color:var(--ink2);font-size:12.5px;white-space:nowrap}
.dot-live{width:7px;height:7px;border-radius:50%;background:var(--sage);animation:live 3.2s ease-in-out infinite}
.dot-live.gray{background:var(--faint);animation:none}
@keyframes live{0%,100%{box-shadow:0 0 0 0 rgba(157,184,154,.45)}50%{box-shadow:0 0 0 6px rgba(157,184,154,0)}}
.title{font-size:30px;font-weight:300;letter-spacing:-.01em;line-height:1.1;display:flex;align-items:center;gap:10px}
.subtitle{font-size:13.5px;color:var(--muted);margin-top:6px}

/* TODAY */
#s-today{display:flex;flex-direction:column}
.hero{margin-top:6px;padding:clamp(16px,3vh,28px) 20px clamp(14px,2.4vh,22px);display:flex;flex-direction:column;align-items:center}
.ringwrap{position:relative;width:min(220px,27vh);aspect-ratio:1}
#s-today.dense .ringwrap{width:min(206px,23.5vh)}
.ringwrap svg{width:100%;height:100%;overflow:visible}
.ring-track{fill:none;stroke:rgba(157,184,154,.16);stroke-width:3;transition:stroke .6s ease}
.ring-track.empty{stroke:rgba(138,141,148,.28);stroke-dasharray:.35 1.65}
.ring-val{fill:none;stroke-width:3.2;stroke-linecap:round}
.ring-ahead{fill:none;stroke:rgba(138,141,148,.2);stroke-width:3.2;stroke-linecap:round}
.ring-glow{fill:none;stroke-width:10;stroke-linecap:round;opacity:.28;filter:blur(7px)}
.ring-disc{transform-origin:120px 120px;transform:scale(.6);opacity:0;transition:transform 1.8s var(--ease),opacity 1.4s ease}
.go .ring-disc{transform:scale(1);opacity:1}
.ring-disc.off{display:none}
.ring-in{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 12px}
.big{font-size:clamp(54px,8.6vh,72px);font-weight:300;line-height:1;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.big.word{font-size:clamp(40px,6.4vh,50px);font-weight:200;letter-spacing:-.02em}
.big.dash{font-weight:200;color:var(--faint)}
.ring-in .lbl{margin-top:8px}
.bio{margin-top:7px;font-size:11.5px;white-space:nowrap;color:var(--sage-d);font-weight:500;line-height:1.35}
.bio.m{color:var(--muted);font-weight:400}
.coach{margin-top:clamp(12px,2.2vh,20px);font-size:14px;line-height:1.5;color:var(--ink2);text-align:center;max-width:290px}
.chips{display:flex;gap:8px;margin-top:12px}
.tchip{flex:1;min-width:0;padding:11px 10px 10px;border-radius:18px;display:flex;flex-direction:column;gap:5px;box-shadow:var(--shadow-s)}
.tchip .lbl{letter-spacing:.07em;font-size:10px}
.tchip .v{font-size:17px;font-weight:400;letter-spacing:-.01em;display:flex;align-items:baseline;gap:4px;white-space:nowrap}
.tchip .v small{font-size:10px;color:var(--sage-d);font-weight:500}
.tchip .v.wait{font-size:14px;color:var(--muted);font-weight:400}
.nudge{margin-top:12px;padding:13px 15px;border-radius:20px;display:flex;gap:12px;align-items:flex-start;width:100%;box-shadow:var(--shadow-s)}
.nudge.apricot{background:linear-gradient(120deg,rgba(248,226,210,.62),rgba(255,255,255,.55))}
.nudge.neutral{background:rgba(255,255,255,.5)}
.nudge .t{flex:none;font-size:12px;font-weight:600;color:var(--apricot-d);padding-top:1px;font-variant-numeric:tabular-nums}
.nudge.neutral .t{color:var(--muted)}
.nudge p{flex:1;font-size:13.5px;line-height:1.48;color:var(--ink2)}
.nudge svg{flex:none;width:16px;height:16px;color:var(--muted);margin-top:2px;opacity:.7}
.quiet{margin-top:10px;width:100%;display:flex;align-items:center;gap:12px;padding:12px 15px;border-radius:20px;background:rgba(255,255,255,.42);border:1px solid var(--line);box-shadow:var(--shadow-s);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}
.quiet .qd{flex:none;width:8px;height:8px;border-radius:50%;background:var(--sage);box-shadow:0 0 0 4px rgba(157,184,154,.18)}
.quiet .qd.lilac{background:var(--lilac);box-shadow:0 0 0 4px rgba(184,176,217,.22)}
.quiet .qt{flex:1;min-width:0}
.quiet .qt .lbl{font-size:9.5px}
.quiet .qt p{font-size:13.5px;color:var(--ink2);margin-top:2px;line-height:1.35}
.quiet .qa{flex:none;font-size:12.5px;color:var(--sage-d);font-weight:500;display:flex;align-items:center;gap:2px}
.quiet .qa svg{width:14px;height:14px}

/* RHYTHM */
.medchip{height:22px;font-size:10.5px}
.chartcard{margin-top:8px;padding:22px 18px 14px}
.steps-h{font-size:44px;font-weight:300;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums}
.steps-h span{font-size:15px;color:var(--muted);font-weight:400;letter-spacing:0;margin-left:6px}
.steps-h.nod{font-size:30px;color:var(--faint);font-weight:200}
.togo{margin-top:6px;font-size:13px;color:var(--muted)}
.togo b{font-weight:500;color:var(--sage-d)}
.chart{margin-top:16px;width:100%;height:auto;overflow:visible}
.xl{font-size:9.5px;fill:var(--faint);font-family:var(--font);letter-spacing:.04em}
.draw{stroke-dasharray:1;stroke-dashoffset:1}
.go .draw{stroke-dashoffset:0;transition:stroke-dashoffset 1.8s var(--ease) .15s}
.area,.fadein{opacity:0}
.go .area{opacity:1;transition:opacity 1.4s ease .7s}
.go .fadein{opacity:1;transition:opacity 1s ease 1.1s}
.pdot{opacity:0;transform-box:fill-box;transform-origin:center;transform:scale(.3)}
.go .pdot{opacity:1;transform:scale(1);transition:opacity .6s ease 1.6s,transform .9s var(--ease) 1.6s}
.emptychart{position:relative}
.emptychart p{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);text-align:center;padding:0 30px}
.lev-h{display:flex;justify-content:space-between;align-items:center;margin:18px 2px 8px}
.levers{display:flex;flex-direction:column;gap:10px}
.lever{border-radius:20px;overflow:hidden;box-shadow:var(--shadow-s)}
.lever-h{width:100%;padding:14px 16px 15px;display:block}
.lever-row{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.lever-name{font-size:14px;color:var(--ink)}
.lever-name b{font-weight:500}
.lever-name span{color:var(--muted);margin-left:6px;font-size:13px}
.lever-meta{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--sage-d);font-weight:500;white-space:nowrap}
.lever.nodata .lever-meta{color:var(--muted);font-weight:400}
.chev{width:14px;height:14px;color:var(--faint);transition:transform .5s var(--ease)}
.lever.open .chev{transform:rotate(180deg)}
.bar{position:relative;height:4px;border-radius:4px;background:rgba(30,33,38,.06);margin-top:12px}
.lever.nodata .bar{background:none;border-top:1.5px dashed rgba(138,141,148,.28);height:0;margin-top:14px}
.zone{position:absolute;top:-4px;bottom:-4px;border-radius:6px;background:rgba(157,184,154,.17)}
.tick{position:absolute;top:-5px;bottom:-5px;width:1.5px;border-radius:1px;background:var(--sage);opacity:.7}
.fill{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:4px;background:linear-gradient(90deg,rgba(157,184,154,.55),var(--sage));transition:width 1.3s var(--ease)}
.fill.warm{background:linear-gradient(90deg,rgba(232,184,152,.5),var(--apricot))}
.lever-more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .55s var(--ease)}
.lever.open .lever-more{grid-template-rows:1fr}
.lever-more>div{overflow:hidden}
.srcs{padding:2px 16px 16px;opacity:0;transform:translateY(-6px);transition:opacity .3s ease,transform .5s var(--ease)}
.lever.open .srcs{opacity:1;transform:none;transition:opacity .5s ease .12s,transform .6s var(--ease) .1s}
.src{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:13px;color:var(--ink2)}
.src svg{width:16px;height:16px;color:var(--muted);flex:none}
.src .sb{flex:1;height:3px;border-radius:3px;background:rgba(30,33,38,.05);position:relative}
.src .sb i{position:absolute;left:0;top:0;bottom:0;border-radius:3px;background:var(--sage);opacity:.55}
.src .g{width:44px;text-align:right;font-variant-numeric:tabular-nums;color:var(--ink)}
.src-note{margin-top:8px;font-size:13px;color:var(--sage-d);font-weight:500}
.foot{margin-top:18px;text-align:center;font-size:12.5px;color:var(--muted);line-height:1.5}

/* PLAN */
.tl{margin-top:22px;padding:18px 14px 12px}
.tl-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pc{padding:12px 10px 11px;border-radius:16px;background:rgba(255,255,255,.34);border:1px solid rgba(255,255,255,.4);opacity:.6;transform:scale(.94);transition:transform .6s var(--ease),opacity .5s ease,background .5s ease,box-shadow .5s ease,scale .35s var(--ease)}
.pc.sel{opacity:1;transform:none;background:rgba(255,255,255,.88);box-shadow:0 10px 30px rgba(90,110,90,.12)}
.pc .d{font-size:17px;font-weight:400;letter-spacing:-.01em}
.pc .n{font-size:11px;color:var(--muted);margin-top:3px}
.pc .w{font-size:10.5px;color:var(--sage-d);margin-top:6px;font-weight:500}
.tl-conn{width:100%;height:26px;overflow:visible}
.tl-conn path{fill:none;stroke:var(--sage);stroke-width:1;vector-effect:non-scaling-stroke;opacity:.35;transition:opacity .5s ease}
.tl-conn path.sel{opacity:.9}
.tl-line{position:relative;height:34px}
.tl-line .ln{position:absolute;left:0;right:0;top:6px;height:1.5px;border-radius:2px;background:linear-gradient(90deg,var(--sage),rgba(157,184,154,.35));transform-origin:left;transform:scaleX(0);transition:transform 1.4s var(--ease) .1s}
.go .tl-line .ln{transform:scaleX(1)}
.node{position:absolute;top:2px;width:10px;height:10px;margin-left:-5px;border-radius:50%;background:#fff;border:1.5px solid var(--sage);transition:transform .5s var(--ease),box-shadow .5s ease,background .5s ease}
.node.sel{transform:scale(1.35);background:var(--sage);box-shadow:0 0 0 5px rgba(157,184,154,.2)}
.node.now{width:6px;height:6px;margin-left:0;top:4px;border:0;background:var(--ink2)}
.mo{position:absolute;top:18px;font-size:9.5px;color:var(--faint);letter-spacing:.06em;transform:translateX(-50%)}
.panel{margin-top:14px;padding:20px 18px 8px}
.panel-h{display:flex;justify-content:space-between;align-items:baseline}
.panel-h h2{font-size:21px;font-weight:400;letter-spacing:-.01em}
.panel-meta{font-size:12.5px;color:var(--muted);margin-top:4px}
.plist{transition:opacity .22s ease,transform .3s ease}
.plist.swap{opacity:0;transform:translateY(6px)}
.grp{margin-top:18px}
.grp .lbl{margin-bottom:4px}
.trow{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-top:1px solid rgba(30,33,38,.05)}
.grp .trow:first-of-type{border-top:0}
.trow .nm{font-size:14.5px}
.trow .why{font-size:12.5px;color:var(--muted);margin-top:2px;line-height:1.4}
.callout{margin-top:14px;padding:15px 16px;border-radius:20px;background:linear-gradient(120deg,rgba(221,214,240,.7),rgba(255,255,255,.5));box-shadow:var(--shadow-s)}
.callout .cr{display:flex;gap:12px;align-items:flex-start}
.callout svg{width:18px;height:18px;color:var(--lilac-d);flex:none;margin-top:1px}
.callout p{font-size:13.5px;line-height:1.45;color:var(--ink2)}
.callout .lbl{color:var(--lilac-d);margin-bottom:3px}
.callout .cb{display:flex;gap:6px;margin:12px 0 0 30px}
.mini{height:32px;padding:0 14px;border-radius:16px;font-size:12.5px;font-weight:500;display:inline-flex;align-items:center;gap:6px;transition:background .4s ease,color .4s ease,scale .35s var(--ease)}
.mini.pri{background:rgba(255,255,255,.85);color:var(--ink);box-shadow:0 4px 12px rgba(90,90,120,.08)}
.mini.sec{color:var(--muted)}
.mini.ok{background:var(--sage-t);color:var(--sage-d)}
.mini svg{width:13px;height:13px}
.cover{margin-top:22px;text-align:center}
.cover p{font-size:12.5px;color:var(--muted)}
.acts{display:flex;justify-content:center;gap:6px;margin-top:12px}
.act{display:flex;align-items:center;gap:6px;height:34px;padding:0 13px;border-radius:17px;font-size:12.5px;color:var(--ink2);background:rgba(255,255,255,.5);border:1px solid var(--line)}
.act svg{width:14px;height:14px;color:var(--muted)}
.conc{margin-top:26px;width:100%;padding:18px 18px;border-radius:22px;display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,rgba(255,255,255,.7),rgba(226,221,244,.55));box-shadow:var(--shadow)}
.conc .ci{flex:none;width:40px;height:40px;border-radius:20px;display:grid;place-items:center;background:rgba(184,176,217,.22);color:var(--lilac-d)}
.conc .ci svg{width:19px;height:19px}
.conc .ct{flex:1}
.conc .ct b{display:block;font-size:15px;font-weight:500}
.conc .ct span{font-size:12.5px;color:var(--muted)}
.conc>svg{width:16px;height:16px;color:var(--faint)}
.prog{padding:4px 16px}
.pr{border-top:1px solid rgba(30,33,38,.05)}
.pr:first-child{border-top:0}
.pr-h{width:100%;display:flex;align-items:center;gap:12px;padding:14px 0}
.pr-h .pm{flex:1;min-width:0}
.pr-h .pm b{display:block;font-size:14.5px;font-weight:400}
.pr-h .pm span{display:block;font-size:12.5px;color:var(--sage-d);margin-top:3px}
.pr-h .pw{font-size:11.5px;color:var(--muted);white-space:nowrap}
.pr-h .src-tag{font-size:10px;margin-left:6px;height:18px;padding:0 7px;vertical-align:1px}
.pr .lever-more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .55s var(--ease)}
.pr.open .lever-more{grid-template-rows:1fr}
.pr.open .chev{transform:rotate(180deg)}
.pr .pd{padding:0 0 14px;opacity:0;transition:opacity .3s ease}
.pr.open .pd{opacity:1;transition:opacity .5s ease .12s}
.pd .kv{display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:4px 0}
.pd .kv span:first-child{color:var(--muted)}
.pd .kv span:last-child{text-align:right;color:var(--ink2)}
.ptrack{height:3px;border-radius:3px;background:rgba(157,184,154,.18);margin:6px 0 8px;overflow:hidden}
.ptrack i{display:block;height:100%;border-radius:3px;background:var(--sage)}
.closedprog{margin-top:10px;padding:6px 16px}
.cp{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 0;border-top:1px solid rgba(30,33,38,.05)}
.cp:first-child{border-top:0}
.cp b{font-size:14px;font-weight:400;display:block}
.cp small{font-size:11.5px;color:var(--muted)}

/* CASES */
.case{position:relative;margin-top:22px;padding:22px 20px 20px;overflow:hidden}
.case::before{content:"";position:absolute;inset:-40% -30% auto auto;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(157,184,154,.38),rgba(157,184,154,0) 70%);pointer-events:none;animation:glow 7s ease-in-out infinite alternate}
.case.muted::before{background:radial-gradient(circle,rgba(184,176,217,.3),rgba(184,176,217,0) 70%)}
@keyframes glow{from{transform:translate(0,0) scale(1)}to{transform:translate(-30px,20px) scale(1.15)}}
.case.flash{animation:flash 1.6s var(--ease)}
@keyframes flash{0%{box-shadow:0 0 0 0 rgba(157,184,154,.5),var(--shadow)}100%{box-shadow:0 0 0 18px rgba(157,184,154,0),var(--shadow)}}
.case>*{position:relative}
.case-body{transition:opacity .25s ease,transform .4s var(--ease)}
.case-body.swap{opacity:0;transform:translateY(6px)}
.case h2{margin-top:16px;font-size:28px;font-weight:300;line-height:1.15;letter-spacing:-.015em}
.case .line{margin-top:10px;font-size:13.5px;line-height:1.5;color:var(--ink2)}
.btns{display:flex;align-items:center;gap:6px;margin-top:20px;flex-wrap:wrap}
.btn{height:44px;padding:0 20px;border-radius:22px;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:8px;transition:background .5s ease,color .5s ease,box-shadow .5s ease,scale .35s var(--ease)}
.btn.pri{background:var(--sage);color:#fff;box-shadow:0 10px 26px rgba(111,143,108,.3)}
.btn.sec{color:var(--muted);padding:0 14px}
.btn svg{width:16px;height:16px}
.iprog{margin-top:18px}
.iprog .ptrack{height:4px;margin:0}
.iprog .row{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:8px}
.tgbtn{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 13px;border-radius:17px;font-size:12.5px;color:var(--ink2);background:rgba(255,255,255,.55);border:1px solid var(--line);box-shadow:var(--shadow-s);white-space:nowrap}
.tgbtn svg{width:15px;height:15px;color:var(--lilac-d)}
.ev-h{display:flex;justify-content:space-between;align-items:baseline;margin:22px 2px 10px}
.ev-h span{font-size:12px;color:var(--muted)}
.strip{display:flex;gap:10px;overflow-x:auto;margin:0 -20px;padding:4px 20px 14px;scroll-snap-type:x mandatory;scrollbar-width:none}
.strip::-webkit-scrollbar{display:none}
.ev{flex:none;width:122px;padding:12px;border-radius:18px;scroll-snap-align:start;background:rgba(255,255,255,.55);border:1px solid var(--line);box-shadow:var(--shadow-s);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}
.ev .dt{font-size:11.5px;color:var(--muted)}
.thumbs{display:flex;margin:10px 0 11px}
.th{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;margin-right:-7px;border:2px solid rgba(255,255,255,.9);box-shadow:0 2px 6px rgba(90,90,120,.08)}
.th svg{width:14px;height:14px;color:rgba(30,33,38,.55)}
.th.hit{box-shadow:0 0 0 1.5px var(--sage),0 2px 6px rgba(90,90,120,.08)}
.win{position:relative;height:3px;border-radius:3px;background:rgba(157,184,154,.18);margin-bottom:9px}
.win i{position:absolute;top:50%;width:7px;height:7px;margin:-3.5px 0 0 -3.5px;border-radius:50%;background:var(--sage)}
.ev.miss{opacity:.62}
.ev.miss .win{background:rgba(30,33,38,.06)}
.case2{margin-top:6px;padding:18px 20px;box-shadow:var(--shadow-s);background:rgba(255,255,255,.45)}
.case2 .top{display:flex;justify-content:space-between;align-items:center}
.case2 h3{font-size:18px;font-weight:400;margin-top:10px;letter-spacing:-.01em}
.case2 .st{font-size:13px;color:var(--ink2);margin-top:6px;line-height:1.5}
.case2 .st2{font-size:12.5px;color:var(--muted);margin-top:10px}
.collect{position:relative;height:3px;border-radius:3px;margin-top:14px;background:rgba(184,176,217,.2);overflow:hidden}
.collect i{position:absolute;left:0;top:0;bottom:0;width:42%;border-radius:3px;background:linear-gradient(90deg,rgba(184,176,217,.3),var(--lilac))}
.collect i::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.8),transparent);animation:shim 3.4s ease-in-out infinite}
@keyframes shim{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.closed{margin-top:24px;padding:0 4px}
.closed .lbl{margin-bottom:6px}
.cl{padding:9px 0;border-top:1px solid rgba(30,33,38,.05)}
.cl:first-of-type{border-top:0}
.cl .a{display:flex;justify-content:space-between;font-size:13.5px;color:var(--ink2)}
.cl .a span:last-child{color:var(--faint);font-size:12px}
.cl .b{font-size:12px;color:var(--muted);margin-top:2px}

/* ME */
.bioc{margin-top:22px;padding:24px 20px 16px}
.bigme{font-size:80px;font-weight:200;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums;margin-top:10px}
.delta{margin-top:10px;font-size:13px;color:var(--sage-d);font-weight:500}
.delta span{color:var(--muted);font-weight:400}
.upd{margin-top:4px;font-size:12px;color:var(--muted)}
.drivers{display:flex;gap:8px;margin-top:14px;overflow-x:auto;scrollbar-width:none;margin-left:-20px;margin-right:-20px;padding:2px 20px 6px}
.drivers::-webkit-scrollbar{display:none}
.drv{flex:none;display:flex;align-items:center;gap:7px;height:38px;padding:0 14px 0 11px;border-radius:19px;font-size:13px;color:var(--ink2);box-shadow:var(--shadow-s)}
.drv svg{width:14px;height:14px}
.drv .up{color:var(--sage-d)}
.drv .dn{color:var(--apricot-d)}
.trends{margin-top:14px;padding:6px 18px}
.tr{display:flex;align-items:center;gap:12px;padding:14px 0;border-top:1px solid rgba(30,33,38,.05)}
.tr:first-child{border-top:0}
.tr .nm{flex:1;font-size:14px}
.tr .nm small{display:block;font-size:11.5px;color:var(--muted);margin-top:2px}
.tr .val{font-size:15px;font-variant-numeric:tabular-nums;text-align:right;min-width:40px}
.tr svg.sp{width:70px;height:26px;overflow:visible}
.tr .arr{width:14px;height:14px;color:var(--sage-d)}
.melinks{margin-top:22px;display:flex;flex-direction:column;align-items:center;gap:2px}
.melinks button{display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--ink2);padding:8px 10px}
.melinks button svg{width:13px;height:13px;color:var(--faint)}
.melinks button.demo{color:var(--muted);font-size:12px;margin-top:8px}

/* tab bar */
.tabbar{position:absolute;z-index:20;left:14px;right:14px;bottom:14px;height:64px;display:grid;grid-template-columns:repeat(4,1fr);padding:6px;border-radius:26px;transition:transform .6s var(--ease)}
.stage.behind~.tabbar{transform:translateY(110px)}
.tb{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:var(--muted);font-size:10.5px;font-weight:500;letter-spacing:.02em;transition:color .4s ease,scale .35s var(--ease)}
.tb svg{width:21px;height:21px}
.tb.on{color:var(--ink)}
.tb .ico{position:relative}
.badge{position:absolute;top:-1px;right:-3px;width:7px;height:7px;border-radius:50%;background:var(--apricot);box-shadow:0 0 0 2px rgba(255,255,255,.9);transform:scale(0);transition:transform .5s var(--ease)}
.badge.on{transform:scale(1)}
.tab-ind{position:absolute;top:6px;left:6px;height:52px;width:calc((100% - 12px)/4);border-radius:20px;background:rgba(255,255,255,.8);box-shadow:0 6px 18px rgba(90,90,120,.09);transition:transform .6s var(--ease)}

/* overlay sheet */
.ov{position:absolute;inset:0;z-index:30;display:none;background:rgba(245,244,241,.72);-webkit-backdrop-filter:blur(34px) saturate(140%);backdrop-filter:blur(34px) saturate(140%)}
.ov.show{display:block}
.ov .screen{height:100%;padding:18px 20px 40px}
.ov-top{display:flex;align-items:center;justify-content:space-between;height:44px}
.back{width:40px;height:40px;border-radius:20px;display:grid;place-items:center;background:rgba(255,255,255,.6);border:1px solid var(--line);margin-left:-4px}
.back svg{width:18px;height:18px}
.ov-hero{margin-top:26px}
.ov-hero .big{font-size:76px;font-weight:200;margin-top:10px}
.ov-hero .big small{font-size:18px;font-weight:400;color:var(--muted);margin-left:6px;letter-spacing:0}
.ov-sub{margin-top:10px;font-size:13.5px;font-weight:500}
.ov-chart{margin-top:22px;padding:20px 16px 12px}
.v2{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:11px;color:var(--muted)}
.v2 i{width:7px;height:7px;border-radius:50%;background:var(--apricot)}
.v2 em{font-style:normal;margin-left:auto;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--apricot-d);background:var(--apricot-t);padding:2px 7px;border-radius:8px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}
.stat{padding:13px 12px;border-radius:18px;background:rgba(255,255,255,.55);border:1px solid var(--line);box-shadow:var(--shadow-s)}
.stat .lbl{letter-spacing:.08em}
.stat .v{font-size:19px;font-weight:300;margin-top:5px;font-variant-numeric:tabular-nums}
.ov-coach{margin-top:22px;font-size:14px;line-height:1.55;color:var(--ink2);text-align:center;padding:0 10px}
.pubs{margin-top:26px}
.pubs .lbl{margin:0 2px 8px}
.pub{display:block;padding:14px 16px;border-radius:18px;background:rgba(255,255,255,.5);border:1px solid var(--line);box-shadow:var(--shadow-s);margin-top:8px}
.pub .pt{font-size:14px;line-height:1.4;color:var(--ink)}
.pub .pr2{display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap}
.pub .pw2{font-size:12px;color:var(--muted)}
.pub .pl{margin-left:auto;font-size:12px;color:var(--sage-d);font-weight:500;display:flex;align-items:center;gap:3px}
.pub .pl svg{width:12px;height:12px}
.tglink{margin:26px auto 0;display:flex;width:max-content}
.meals{display:flex;gap:10px;overflow-x:auto;margin:14px -20px 0;padding:4px 20px 12px;scrollbar-width:none}
.meals::-webkit-scrollbar{display:none}
.meal{flex:none;width:108px;padding:12px;border-radius:18px;background:rgba(255,255,255,.55);border:1px solid var(--line);box-shadow:var(--shadow-s)}
.meal .ph{width:100%;aspect-ratio:1.3;border-radius:12px;display:grid;place-items:center}
.meal .ph svg{width:26px;height:26px;color:rgba(30,33,38,.45)}
.meal b{display:block;font-size:12.5px;font-weight:500;margin-top:9px;line-height:1.3}
.meal span{display:block;font-size:11px;color:var(--muted);margin-top:3px}
.week{margin-top:14px;padding:20px 18px 18px;display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:center}
.dial{position:relative;text-align:center}
.dial svg{width:100%;max-width:150px;margin:0 auto;overflow:visible}
.dial .dv{position:absolute;left:0;right:0;bottom:4px;font-size:34px;font-weight:200;letter-spacing:-.02em}
.dial .lbl{margin-top:8px}
.plants{border-left:1px solid rgba(30,33,38,.06);padding-left:16px}
.plants .pv{font-size:42px;font-weight:200;letter-spacing:-.02em;line-height:1}
.plants p{font-size:12.5px;color:var(--ink2);margin-top:6px;line-height:1.4}
.plants p b{font-weight:500;color:var(--sage-d)}
.cl-list{margin-top:18px}
.cline{display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-top:1px solid rgba(30,33,38,.05)}
.cline:first-child{border-top:0}
.cline .n{flex:none;width:18px;font-size:12px;color:var(--faint);padding-top:2px;font-variant-numeric:tabular-nums}
.cline p{flex:1;font-size:14px;line-height:1.45;color:var(--ink)}
.cline .mini{flex:none;height:28px;padding:0 11px;font-size:11.5px}
.stgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.stile{padding:14px 12px 13px;border-radius:20px;background:rgba(255,255,255,.52);border:1px solid var(--line);box-shadow:var(--shadow-s);display:flex;flex-direction:column;align-items:flex-start;gap:8px;transition:box-shadow .4s ease,background .4s ease,scale .35s var(--ease)}
.stile.cur{background:rgba(255,255,255,.88);box-shadow:0 0 0 1.5px var(--sage),var(--shadow-s)}
.stile svg.mr{width:54px;height:54px}
.stile b{font-size:14px;font-weight:500}
.stile b span{font-weight:400;color:var(--muted);margin-left:5px;font-size:12px}
.stile small{font-size:11.5px;color:var(--muted);line-height:1.35}
.stile .flags{display:flex;gap:4px;min-height:8px}
.stile .flags i{width:6px;height:6px;border-radius:50%}

/* toast */
.toast{position:absolute;z-index:40;left:20px;right:20px;margin:0 auto;width:fit-content;bottom:94px;display:flex;align-items:center;gap:14px;padding:12px 12px 12px 18px;border-radius:20px;font-size:13px;color:var(--ink2);transform:translateY(20px);opacity:0;pointer-events:none;transition:transform .55s var(--ease),opacity .35s ease}
.toast.show{transform:none;opacity:1;pointer-events:auto}
.toast button{font-size:12.5px;font-weight:600;color:var(--sage-d);padding:6px 8px;border-radius:12px;white-space:nowrap}
.toast span{line-height:1.4}

@media (max-height:700px){
  .coach{font-size:13px;margin-top:10px}
  .nudge{padding:10px 13px}
  .nudge p{font-size:12.5px}
  .tchip{padding:9px 9px 8px}
  .quiet{padding:9px 13px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition-duration:.01ms!important;transition-delay:0s!important}
}
.tb.inert{opacity:.32;pointer-events:none}
</style>
</head>
<body>
<div id="app">
  <div class="blobs" aria-hidden="true"><div class="blob"><b></b></div><div class="blob"><b></b></div><div class="blob"><b></b></div><div class="blob"><b></b></div></div>

  <main class="stage" id="stage">
    <section class="tab on" data-tab="today" aria-label="Сегодня">
      <div class="topbar">
        <div class="switcher" role="tablist">
          <span class="sw-ind" id="swInd"></span>
          <button class="on" data-sw="0" role="tab">Сегодня</button>
          <button data-sw="1" role="tab">Ритм</button>
        </div>
      </div>
      <div class="pager" id="pager">
        <div class="track" id="track">
          <div class="screen" id="s-today">
            <div class="hdr rise" style="--i:0"><span id="tDate"></span><span class="status" id="tStatus"></span></div>
            <div class="glass hero rise press" style="--i:1">
              <div class="ringwrap" id="ring">
                <svg viewBox="0 0 240 240" aria-hidden="true">
                  <defs>
                    <linearGradient id="rg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#CFE0CB"/><stop offset=".55" stop-color="#A9C4A5"/><stop offset="1" stop-color="#7FA07C"/></linearGradient>
                    <radialGradient id="disc" cx=".5" cy=".5" r=".5"><stop offset=".55" stop-color="#9DB89A" stop-opacity="0"/><stop offset="1" stop-color="#9DB89A" stop-opacity=".13"/></radialGradient>
                  </defs>
                  <circle class="ring-disc" id="ringDisc" cx="120" cy="120" r="102" fill="url(#disc)"/>
                  <circle class="ring-track" id="ringTrack" cx="120" cy="120" r="104" pathLength="100" transform="rotate(-90 120 120)"/>
                  <circle class="ring-ahead" id="ringAhead" cx="120" cy="120" r="104" pathLength="100" stroke-dasharray="0 100"/>
                  <circle class="ring-glow" id="ringGlow" cx="120" cy="120" r="104" stroke="url(#rg)" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 120 120)"/>
                  <circle class="ring-val" id="ringVal" cx="120" cy="120" r="104" stroke="url(#rg)" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 120 120)"/>
                  <g id="ringTip" opacity="0"><circle r="9" fill="#9DB89A" opacity=".18"/><circle r="4" fill="#fff" stroke="#7FA07C" stroke-width="1.5"/></g>
                </svg>
                <div class="ring-in" id="ringIn"></div>
              </div>
              <p class="coach" id="coach"></p>
            </div>
            <div class="chips" id="chips"></div>
            <div id="tExtra"></div>
          </div>

          <div class="screen" id="s-rhythm">
            <div class="hdr rise" style="--i:0"><span>Ритм дня</span><span class="status" id="rStatus"></span></div>
            <div class="glass chartcard rise" style="--i:1" id="rhythmChart"></div>
            <div class="lev-h rise" style="--i:2"><span class="lbl">Рычаги дня</span><button class="linkline" data-a="stub">Питание за вчера<svg class="ic" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button></div>
            <div class="levers" id="levers"></div>
            <p class="foot rise" style="--i:7" id="rFoot"></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <nav class="glass tabbar" id="tabbar" role="tablist">
    <span class="tab-ind" id="tabInd"></span>
    <button class="tb on press" data-go="today"><span class="ico"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" opacity=".35"/><path d="M12 4a8 8 0 0 1 7.2 11.5"/></svg></span>Сегодня</button>
    <button class="tb press inert" data-go="plan" aria-disabled="true"><span class="ico"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="3.5"/><path d="M8 3v4M16 3v4M4 10h16"/></svg></span>План</button>
    <button class="tb press inert" data-go="cases" aria-disabled="true"><span class="ico"><svg class="ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg></span>Кейсы</button>
    <button class="tb press inert" data-go="me" aria-disabled="true"><span class="ico"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1.2-3.6 3.9-5.5 7-5.5s5.8 1.9 7 5.5"/></svg></span>Я</button>
  </nav>

  <div class="glass toast" id="toast" role="status"><span id="toastT"></span><button id="toastB">Ок</button></div>
</div>

<script>
(()=>{
/* Vita v1 (2026-09-26) — «Сегодня»/«Ритм» на живых данных card-service.
   Вёрстка/анимации/палитра — из утверждённого макета, без изменений.
   Вся логика — на сервере (/vita/today, /vita/rhythm); здесь только рендер. */
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const haptic=(ms=6)=>{try{navigator.vibrate&&navigator.vibrate(ms)}catch(e){}};
const eo4=t=>1-Math.pow(1-t,4);
function tween(dur,fn,ease=eo4){return new Promise(res=>{if(reduce){fn(1);res();return}const t0=performance.now();const f=n=>{const t=Math.min(1,(n-t0)/dur);fn(ease(t));t<1?requestAnimationFrame(f):res()};requestAnimationFrame(f)})}
const fmt=(v,dec=0)=>v==null?'—':(dec?v.toFixed(dec).replace('.',','):Math.round(v).toLocaleString('ru-RU'));
const fmtSigned=(v,dec=1)=>{const s=v>0?'+':(v<0?'−':'');return s+Math.abs(v).toFixed(dec).replace('.',',')};
function countUp(el,to,{dur=1500,dec=0,from=0}={}){if(to==null){el.textContent='—';return}tween(dur,p=>{el.textContent=fmt(from+(to-from)*p,dec)})}
const replay=el=>{if(!el)return;el.classList.remove('go');void el.getBoundingClientRect();el.classList.add('go')};
function hhmm(min){if(min==null)return '—';return Math.floor(min/60)+':'+String(Math.round(min%60)).padStart(2,'0')}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}

const I={
  chev:'<path d="M6 9l6 6 6-6"/>', right:'<path d="M9 6l6 6-6 6"/>',
  check:'<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  meal:'<path d="M7 3v7a2 2 0 0 0 4 0V3M9 10v11M17 3c-2 2-2 5-2 7a2 2 0 0 0 4 0c0-2 0-5-2-7zM17 10v11"/>',
};
const svg=(k,cls='ic')=>`<svg class="${cls}" viewBox="0 0 24 24">${I[k]}</svg>`;

function smooth(p){let d=`M${p[0][0].toFixed(1)},${p[0][1].toFixed(1)}`;for(let i=0;i<p.length-1;i++){const a=p[i-1]||p[i],b=p[i],c=p[i+1],e=p[i+2]||c,t=1/6;d+=` C${(b[0]+(c[0]-a[0])*t).toFixed(1)},${(b[1]+(c[1]-a[1])*t).toFixed(1)} ${(c[0]-(e[0]-b[0])*t).toFixed(1)},${(c[1]-(e[1]-b[1])*t).toFixed(1)} ${c[0].toFixed(1)},${c[1].toFixed(1)}`}return d}
const pulse=(x,y,c)=>`<g class="pdot"><circle cx="${x}" cy="${y}" r="4" fill="${c}" opacity=".4"><animate attributeName="r" values="4;13" dur="2.6s" repeatCount="indefinite"/><animate attributeName="opacity" values=".45;0" dur="2.6s" repeatCount="indefinite"/></circle></g>`;

const WD_FULL=['Воскресенье','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота'];
const MONTHS=['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
function dateLabel(iso){const d=new Date(iso+'T00:00:00');return WD_FULL[d.getDay()]+', '+d.getDate()+' '+MONTHS[d.getMonth()]}

/* ================= ЗАГРУЗКА ================= */
const VITA={today:null,rhythm:null};
async function authedFetch(url){
  const r=await fetch(url,{cache:'no-store',credentials:'same-origin'});
  if(r.status===401){location.href='/vita/login';throw new Error('unauthorized')}
  if(!r.ok)throw new Error('HTTP '+r.status);
  return r.json();
}
async function loadToday(){
  try{VITA.today=await authedFetch('/vita/today');renderToday();if(pIdx===0)enterToday()}
  catch(e){if(e.message!=='unauthorized')$('#s-today').innerHTML='<p class="foot" style="margin-top:60px">Не удалось загрузить данные. Потяни вниз, чтобы обновить.</p>'}
}
async function loadRhythm(){
  try{VITA.rhythm=await authedFetch('/vita/rhythm');renderRhythm();if(pIdx===1)enterRhythm()}
  catch(e){if(e.message!=='unauthorized')$('#s-rhythm').innerHTML='<p class="foot" style="margin-top:60px">Не удалось загрузить данные. Потяни вниз, чтобы обновить.</p>'}
}

/* ================= TODAY ================= */
const ring={val:$('#ringVal'),glow:$('#ringGlow'),tip:$('#ringTip'),ahead:$('#ringAhead'),track:$('#ringTrack'),disc:$('#ringDisc')};

function statusWord(T){
  const st=T.state;
  if(st.no_watch)return['Часы не на связи','gray'];
  if(st.time_of_day==='morning')return['Доброе утро',''];
  if(st.closed)return['День закрыт',''];
  const s=T.ring.score;
  if(s==null)return['Идёт день',''];
  if(s>=80)return['Всё хорошо',''];
  if(s>=55)return['Обычный день',''];
  return['Тяжеловато сегодня',''];
}
function coachText(T){
  const st=T.state,r=T.ring,ch=T.chips;
  if(st.no_watch)return'Нет данных с часов — день не оценивается.';
  if(st.time_of_day==='morning')return'День начинается — всё впереди.';
  if(st.no_food)return'Еда пока не записана — остальное идёт хорошо.';
  if(st.closed){
    if(r.score!=null&&r.score>=80)return'Хороший день закрыт — так держать.';
    if(r.score!=null&&r.score>=55)return'День закрыт, ровно.';
    return'День закрыт — не самый лёгкий, завтра догонишь.';
  }
  const bits=[];
  if(r.score!=null&&r.score>=80)bits.push('Хороший день.');
  else if(r.score!=null&&r.score<55)bits.push('Немного тяжеловато сегодня.');
  else bits.push('Обычный день.');
  if(T.nudge&&T.nudge.go==='protein'&&ch.protein_consumed!=null)bits.push('Закрой белок — и день будет ровнее.');
  return bits.join(' ');
}

function renderToday(){
  const T=VITA.today;if(!T)return;
  $('#tDate').textContent=dateLabel(T.date);
  const[w,cls]=statusWord(T);
  $('#tStatus').innerHTML=`<i class="dot-live ${cls}"></i>${esc(w)}`;

  const st=T.state,r=T.ring,ch=T.chips;
  let center;
  if(st.no_watch){
    center=`<div class="big dash">—</div><div class="lbl">Не оценивается</div><div class="bio m">нет данных с часов</div>`;
  }else if(st.time_of_day==='morning'){
    const sl=ch.sleep_min!=null?hhmm(ch.sleep_min):null;
    center=`<div class="big word">Утро</div><div class="lbl">${sl?'Сон закрыт · '+sl:'Ещё нет данных'}</div><div class="bio m">остальное впереди</div>`;
  }else if(st.no_food){
    center=`<div class="big" id="dayScore">0</div><div class="lbl">Здоровье дня</div><div class="bio m">без питания — ждёт записи</div>`;
  }else{
    const bio=r.bioage_days;
    const bioTxt=bio==null?'':`вклад дня: ${fmtSigned(bio)} дн.`;
    center=`<div class="big" id="dayScore">0</div><div class="lbl">${st.closed?'День закрыт':'Здоровье дня'}</div><div class="bio">${bioTxt}</div>`;
  }
  $('#ringIn').innerHTML=center;
  $('#coach').textContent=coachText(T);

  const items=[];
  items.push(['sleep','Сон',ch.sleep_min!=null?hhmm(ch.sleep_min):'wait']);
  items.push(['hrv','ВСР',ch.hrv.value!=null?[String(Math.round(ch.hrv.value)),ch.hrv.trend]:'wait']);
  items.push(['energy','Энергия',ch.energy!=null?String(Math.round(ch.energy)):'wait']);
  items.push(['food','Еда',ch.protein_consumed!=null?fmt(ch.protein_consumed)+' г':'wait']);
  $('#chips').innerHTML=items.map(([k,l,v],i)=>{
    let val;
    if(v==='wait')val=`<span class="v wait">ждёт</span>`;
    else if(Array.isArray(v))val=`<span class="v">${esc(v[0])}${v[1]?`<small>${esc(v[1])}</small>`:''}</span>`;
    else val=`<span class="v">${esc(v)}</span>`;
    return `<button class="glass tchip rise press" style="--i:${2+i}" data-a="stub"><span class="lbl">${l}</span>${val}</button>`;
  }).join('');

  let extra='',i=6;
  if(T.nudge)extra+=`<button class="glass nudge ${T.nudge.tone} rise press" style="--i:${i++}" data-a="nudge" data-go="${T.nudge.go||''}"><span class="t">·</span><p>${esc(T.nudge.text)}</p>${svg('right')}</button>`;
  $('#tExtra').innerHTML=extra;
  $('#s-today').classList.toggle('dense',!!T.nudge);
}

function enterToday(){
  reveal($('#s-today'));const T=VITA.today;if(!T)return;
  ring.tip.setAttribute('opacity','0');ring.ahead.setAttribute('stroke-dasharray','0 100');
  const hasRing=!T.state.no_watch&&T.ring.score!=null;
  ring.track.classList.toggle('empty',!hasRing);ring.disc.classList.toggle('off',!hasRing);
  ring.val.style.strokeDashoffset=100;ring.glow.style.strokeDashoffset=100;
  replay($('#ring'));if(!hasRing)return;
  const V=T.ring.score,n=$('#dayScore');ring.tip.setAttribute('opacity','1');
  tween(1900,p=>{const v=V*p;ring.val.style.strokeDashoffset=100-v;ring.glow.style.strokeDashoffset=100-v;const a=(-90+3.6*v)*Math.PI/180;
    ring.tip.setAttribute('transform',`translate(${120+104*Math.cos(a)},${120+104*Math.sin(a)})`);if(n)n.textContent=Math.round(v)},t=>1-Math.pow(1-t,3.2)).then(()=>{
    if(T.state.time_of_day==='morning'){const ahead=100-V-4;ring.ahead.setAttribute('transform',`rotate(${-90+3.6*V+4} 120 120)`);tween(1400,p=>ring.ahead.setAttribute('stroke-dasharray',`${Math.max(0,ahead)*p} 100`))}
  });
}

/* ================= RHYTHM ================= */
function renderRhythm(){
  const R=VITA.rhythm;if(!R)return;
  const g=R.gate;
  $('#rStatus').innerHTML=(g.blocked?`<span class="chip lilac medchip">${esc(g.label)}</span>`:'');

  const s=R.steps,w=330,h=170,padT=12,padB=20,ih=h-padT-padB;
  const x=t=>6+(t-6)/16*(w-12),y=v=>padT+ih-Math.min(1,v/Math.max(s.target*1.15,1))*ih;
  const target=s.target;
  const tgt=[];for(let t=6;t<=22.001;t+=.5)tgt.push([x(t),y(target*Math.pow(Math.max(0,(t-6)/16),.7))]);
  const lab=[6,10,14,18,22].map(t=>`<text class="xl" x="${x(t)}" y="${h-3}" text-anchor="middle">${t}:00</text>`).join('');
  const tl=`<path class="fadein" d="${smooth(tgt)}" fill="none" stroke="#9DB89A" stroke-width="1.3" stroke-dasharray="1.5 5" stroke-linecap="round" opacity=".75"/>`;
  let html;
  if(s.now_steps==null){
    html=`<div class="steps-h nod">Шаги</div><div class="togo">нет данных с часов — день не оценивается</div>
    <div class="emptychart"><svg class="chart" viewBox="0 0 ${w} ${h}">${tl}${lab}</svg><p>Шаги появятся, когда часы снова будут на руке</p></div>`;
  }else{
    const nx=x(Math.min(22,Math.max(6,s.now_hour))),ny=y(s.now_steps);
    const left=Math.max(0,target-s.now_steps);
    const togo=left?`осталось <b>${fmt(left)}</b>${R.gate.blocked?' · цель снижена на сегодня':''}`:`цель <b>${fmt(target)}</b> взята`;
    html=`<div class="steps-h"><em id="stepsN" style="font-style:normal">0</em><span>шагов</span></div><div class="togo">${togo}</div>
    <svg class="chart" viewBox="0 0 ${w} ${h}">${tl}
    <line class="fadein" x1="${nx}" x2="${nx}" y1="${padT}" y2="${h-padB}" stroke="#9DB89A" stroke-width="1" opacity=".25"/>
    <text class="xl fadein" x="${nx>w-70?nx-8:nx+8}" y="${padT+6}" text-anchor="${nx>w-70?'end':'start'}" style="fill:#6F8F6C">сейчас</text>
    ${pulse(nx,ny,'#9DB89A')}<circle class="pdot" cx="${nx}" cy="${ny}" r="4" fill="#fff" stroke="#9DB89A" stroke-width="2"/>${lab}</svg>`;
  }
  $('#rhythmChart').innerHTML=html;$('#rhythmChart').dataset.steps=s.now_steps??'';
  renderLevers();
  const anyStreak=Object.values(R.levers).some(l=>l.has_data&&l.streak_days>1);
  $('#rFoot').textContent=anyStreak?'Серия жива — не давай ей прерваться.':'Рычаги оживают после первой записи еды.';
}

const LEV_ORDER=[['fat','Насыщенные жиры'],['protein','Белок'],['sodium','Натрий']];
function renderLevers(){
  const R=VITA.rhythm;if(!R)return;
  $('#levers').innerHTML=LEV_ORDER.map(([k,name],i)=>{
    const l=R.levers[k];
    if(!l||!l.has_data){
      const pw=k==='protein';
      return `<div class="glass lever nodata rise" style="--i:${i+3}" data-lever="${k}"><div class="lever-h"><div class="lever-row"><span class="lever-name"><b>${name}</b></span><span class="lever-meta">${pw?'ждёт первого приёма':'нет данных сегодня'}</span></div><div class="bar"></div>
      ${pw?`<button class="linkline" style="margin-top:12px" data-a="stub">Записать в дневнике${svg('right')}</button>`:''}</div></div>`;
    }
    const dec=l.target<10?1:0;
    const metaTxt=k==='protein'?(l.status==='done'?'закрыт':'осталось '+fmt(l.target-l.consumed,dec)):(l.streak_days>0?`серия ${l.streak_days} ${plural(l.streak_days,'день','дня','дней')}`:'запас есть');
    const smax=Math.max(1,...l.sources.map(s=>s.value));
    return `<div class="glass lever rise press" style="--i:${i+3}" data-lever="${k}"><button class="lever-h" data-a="lever" data-k="${k}" aria-expanded="false">
      <div class="lever-row"><span class="lever-name"><b>${name}</b><span>${fmt(l.consumed,dec)}/${fmt(l.target,dec)} ${l.unit}</span></span><span class="lever-meta">${metaTxt}${svg('chev','ic chev')}</span></div>
      <div class="bar"><span class="fill${l.status==='over'?' warm':''}" data-w="${Math.min(100,l.consumed/l.target*100)}"></span></div></button>
      <div class="lever-more"><div><div class="srcs">${l.sources.map(s=>`<div class="src">${svg('meal')}<span style="width:96px">${esc(s.name)}</span><span class="sb"><i style="width:${s.value/smax*100}%"></i></span><span class="g">${fmt(s.value,dec)} ${l.unit}</span></div>`).join('')}<p class="src-note">${esc(l.note)}</p></div></div></div>`;
  }).join('');
}
function plural(n,a,b,c){const m=n%10,h=n%100;return m===1&&h!==11?a:m>=2&&m<=4&&(h<12||h>14)?b:c}
function openLever(k){$$('.lever').forEach(el=>{const on=el.dataset.lever===k&&!el.classList.contains('open')&&!el.classList.contains('nodata');el.classList.toggle('open',on);const b=$('.lever-h',el);b&&b.setAttribute('aria-expanded',on)})}
function enterRhythm(){reveal($('#s-rhythm'));replay($('#rhythmChart'));const s=$('#rhythmChart').dataset.steps;if(s)countUp($('#stepsN'),+s,{dur:1700});
  $$('.fill').forEach(f=>{f.style.transition='none';f.style.width='0';void f.offsetWidth;f.style.transition='';setTimeout(()=>f.style.width=f.dataset.w+'%',350)})}

/* ================= НАВИГАЦИЯ (свайп/свитчер Сегодня↔Ритм) ================= */
function reveal(tabEl){$$('.rise',tabEl).forEach(e=>e.classList.add('in'))}
const track=$('#track'),pager=$('#pager'),swInd=$('#swInd');
let pIdx=0;
function setPage(i,skipAnim){
  pIdx=i;
  track.style.transition=skipAnim?'none':'';
  track.style.transform=`translateX(${-i*50}%)`;
  swInd.style.transform=`translateX(${i*100}%)`;
  $$('.switcher button').forEach((b,bi)=>b.classList.toggle('on',bi===i));
  if(i===0)enterToday();else enterRhythm();
}
$('.switcher').addEventListener('click',e=>{const b=e.target.closest('button[data-sw]');if(!b)return;haptic();setPage(+b.dataset.sw)});
(function(){
  let sx=0,sy=0,tracking=false;
  pager.addEventListener('touchstart',e=>{if(e.touches.length!==1)return;sx=e.touches[0].clientX;sy=e.touches[0].clientY;tracking=true},{passive:true});
  pager.addEventListener('touchend',e=>{if(!tracking)return;tracking=false;const t=e.changedTouches[0];const dx=t.clientX-sx,dy=t.clientY-sy;
    if(Math.abs(dx)<60||Math.abs(dx)<Math.abs(dy)*1.5)return;
    const next=pIdx+(dx<0?1:-1);if(next<0||next>1)return;haptic();setPage(next);
  },{passive:true});
})();

/* ================= TABBAR (План/Кейсы/Я — неактивны в v1) ================= */
$('#tabbar').addEventListener('click',e=>{
  const b=e.target.closest('.tb');if(!b)return;
  if(b.classList.contains('inert')){toast('Появится в следующем обновлении');return}
});

/* ================= TOAST ================= */
let tt;const tEl=$('#toast'),tB=$('#toastB');
function toast(msg){clearTimeout(tt);$('#toastT').textContent=msg;tEl.classList.add('show');tt=setTimeout(()=>tEl.classList.remove('show'),3200)}
tB.addEventListener('click',()=>{tEl.classList.remove('show')});

document.addEventListener('click',e=>{
  const t=e.target.closest('[data-a]');if(!t)return;
  const a=t.dataset.a;
  switch(a){
    case'stub':haptic();toast('Появится в следующем обновлении');break;
    case'lever':haptic();openLever(t.dataset.k);break;
    case'nudge':haptic();if(t.dataset.go==='watch'){toast('Как только часы будут на руке — данные подтянутся сами.')}else if(t.dataset.go==='protein'){setPage(1)}break;
  }
});

/* ================= ТЕМА / ЗАПУСК ================= */
loadToday();loadRhythm();
setInterval(()=>{loadToday();loadRhythm()},5*60*1000); /* фон обновляет данные каждые 5 минут — приложение живёт на телефоне часами */
})();
</script>
</body>
</html>
